rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Users can manage their own data. Admins have full access.
    match /users/{userId} {
      allow read, write: if request.auth.uid == userId || isAdmin();
    }

    // Users can manage their own appointments. Admins have full access.
    match /agendamentos/{appointmentId} {
      allow read, create: if request.auth.uid == request.resource.data.userId || isAdmin();
      allow update, delete: if isAdmin(); // Or stricter owner-only rules if needed
    }

    // Users can read their own payment history. Admins have full access.
    match /payments/{paymentId} {
        allow read, create: if request.auth.uid == request.resource.data.userId || isAdmin();
        allow update, delete: if isAdmin();
    }

    // All authenticated users can read services and plans. Admins can write.
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
